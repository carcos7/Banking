{
    "Logging": {
        "LogLevel": {
            "Default": "Debug",
            "System": "Information",
            "Microsoft": "Information"
        }
    },
    "ConnectionStrings": {
        "TransactionDb": "Host=transaction-db;Port=5432;Database=transactions;Username=postgres;Password=postgres$;Pooling=true;"
        //"TransactionDb": "Host=localhost;Port=5434;Database=transactions;Username=postgres;Password=postgres$;Pooling=true;"
    },
    "Kafka": {
        "BootstrapServers": "kafka:9092",
        "Topics": {
            "TransactionCreated": "transactions.created",
            "TransactionValidated": "transactions.validated"
        },
        "ConsumerGroupId": "transaction-status-update"
    }
}